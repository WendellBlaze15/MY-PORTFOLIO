# Public site URL used for metadata, sitemap, and canonical links
NEXT_PUBLIC_SITE_URL=https://your-vercel-domain.vercel.app

# EmailJS (contact form). These are browser-side identifiers, not secrets.
# Set them in .env.local for local dev and in Vercel → Settings → Environment Variables.
# Template setup (styled email + Reply-To so replies reach the sender): docs/emailjs/README.md
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
